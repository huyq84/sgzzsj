# 数据库配置
MONGODB_URI=mongodb://localhost:27017/construction_system

# JWT密钥
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# 服务器配置
PORT=5000
NODE_ENV=development

# 客户端URL
CLIENT_URL=http://localhost:3000

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# ===================
# 大模型管理器配置
# ===================

# 默认使用的LLM提供商 (openai/claude/qianfan/local)
LLM_DEFAULT_PROVIDER=openai

# 启用的提供商列表（逗号分隔）
LLM_ENABLED_PROVIDERS=openai,qianfan,local

# 自动故障转移
LLM_AUTO_FAILOVER=true

# 负载均衡策略 (round_robin/weighted/cost_optimized)
LLM_LOAD_BALANCING=cost_optimized

# 重试配置
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1000

# 健康检查间隔（毫秒，0表示禁用）
LLM_HEALTH_CHECK_INTERVAL=300000

# ===================
# OpenAI 配置
# ===================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3

# ===================
# Claude (Anthropic) 配置
# ===================
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=2000
CLAUDE_TEMPERATURE=0.3

# ===================
# 百度千帆 配置
# ===================
QIANFAN_API_KEY=your_qianfan_api_key_here
QIANFAN_SECRET_KEY=your_qianfan_secret_key_here
QIANFAN_BASE_URL=https://aip.baidubce.com
QIANFAN_MODEL=ERNIE-Bot-turbo
QIANFAN_MAX_TOKENS=2000
QIANFAN_TEMPERATURE=0.3

# ===================
# 本地大模型 配置
# ===================
# 本地LLM服务器URL
LOCAL_LLM_URL=http://localhost:11434

# 服务器类型 (ollama/textgen/vllm)
LOCAL_LLM_TYPE=ollama

# 使用的模型名称
LOCAL_LLM_MODEL=llama2:7b-chat

# 嵌入模型（仅Ollama支持）
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# 本地模型配置
LOCAL_MAX_TOKENS=2000
LOCAL_TEMPERATURE=0.3
LOCAL_TIMEOUT=60000

# ===================
# 向量数据库配置
# ===================

# 向量数据库类型 (pinecone/chroma/weaviate/none)
VECTOR_DB_TYPE=none

# Pinecone配置
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=construction-knowledge
PINECONE_ENVIRONMENT=us-east1-gcp

# ChromaDB配置（本地部署推荐）
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=construction_knowledge

# Weaviate配置
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your_weaviate_api_key

# 通用向量数据库配置
VECTOR_DB_ENDPOINT=
VECTOR_DB_API_KEY=

# ===================
# AI增强功能配置
# ===================

# 是否启用AI增强功能
ENABLE_AI_ENHANCEMENT=true

# AI生成质量阈值
AI_QUALITY_THRESHOLD=0.7

# 生成内容的最大token数量
MAX_TOKENS=2000

# 生成温度（0-1，越低越确定）
GENERATION_TEMPERATURE=0.3

# ===================
# 用户选择界面配置
# ===================

# 是否显示模型选择器
SHOW_MODEL_SELECTOR=true

# 是否显示提供商切换选项
SHOW_PROVIDER_SWITCHER=true

# 是否显示成本信息
SHOW_COST_INFO=true

# 是否允许用户自定义生成参数
ALLOW_CUSTOM_PARAMETERS=true

# ===================
# 其他服务配置
# ===================

# 邮件服务配置（用于通知）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# 系统配置
SYSTEM_ADMIN_EMAIL=admin@example.com
BACKUP_INTERVAL=24

# ===================
# 开发和调试配置
# ===================

# 是否启用详细日志
ENABLE_VERBOSE_LOGGING=false

# 是否启用API调用统计
ENABLE_API_METRICS=true

# 是否启用成本追踪
ENABLE_COST_TRACKING=true