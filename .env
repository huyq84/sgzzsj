# 数据库配置
MONGODB_URI=mongodb://localhost:27017/construction_system

# JWT密钥
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# 服务器配置
PORT=5000
NODE_ENV=development

# 客户端URL
CLIENT_URL=http://localhost:3000

# 文件上传配置
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# AI服务配置
## OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
USE_CUSTOM_MODEL=false
CUSTOM_MODEL_ID=ft:gpt-3.5-turbo:company:construction:abc123

## 向量数据库配置（选择一种）
# Pinecone配置
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=construction-knowledge
PINECONE_ENVIRONMENT=us-east1-gcp

# ChromaDB配置
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=construction_knowledge

# Weaviate配置
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your_weaviate_api_key

# 向量数据库选择 (pinecone/chroma/weaviate/none)
VECTOR_DB_TYPE=none
VECTOR_DB_ENDPOINT=
VECTOR_DB_API_KEY=

## 其他AI配置
# 是否启用AI增强功能
ENABLE_AI_ENHANCEMENT=true

# AI生成质量阈值
AI_QUALITY_THRESHOLD=0.7

# 最大token数量
MAX_TOKENS=2000

# 生成温度（0-1，越低越确定）
GENERATION_TEMPERATURE=0.3

# 邮件服务配置（用于通知）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# 系统配置
SYSTEM_ADMIN_EMAIL=admin@example.com
BACKUP_INTERVAL=24